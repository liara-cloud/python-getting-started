*.py[cod]

# Distribution / packaging
.Python
env/
venv/
ENV/
env.bak/
venv.bak/
.venv 

# Pipenv
Pipfile
Pipfile.lock

# PyInstaller
*.spec

# IDE/editor-specific files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Logs and databases
*.log
*.sqlite3

# ===============================
# Streamlit-specific ignores
# ===============================
# Streamlit cache directory
.streamlit/

